{
  "manifest_version": 3,
  "name": "Stockbit Screener & Movers Saver",
  "version": "1.0.0",
  "description": "Ekspor dan sinkronisasi otomatis Stockbit Screener & Movers ke Excel (.xlsx) dan Google Spreadsheet terpadu.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://stockbit.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://*.google.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://stockbit.com/*"
      ],
      "js": [
        "xlsx.full.min.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "stockbit-screener-movers-saver@antigravity",
      "strict_min_version": "109.0"
    }
  }
}
